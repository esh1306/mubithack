generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Broker {
  id          String       @id
  name        String
  clients     Client[]
  lines       Line[]
  precedents  Precedent[]
  pastEntries PastEntry[]
}

model Line {
  id          Int         @id @default(autoincrement())
  brokerId    String
  broker      Broker      @relation(fields: [brokerId], references: [id])
  batchId     String
  text        String
  value       Float?
  qty         Float?
  origin      String?
  neverSeen   Boolean     @default(false)
  source      String?     // "shopify" when imported from a store
  externalRef String?     // e.g. the Shopify inventory item id, for writing the code back
  existingCode String?    // the code the source system already had, if any
  clientId    Int?        // the importer this invoice is for
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  suggestions Suggestion[]
}

model Suggestion {
  id            Int      @id @default(autoincrement())
  lineId        Int
  line          Line     @relation(fields: [lineId], references: [id])
  code          String
  reason        String
  confidence    Float
  flagged       Boolean
  question      String?
  status        String   @default("pending") // pending | approved | corrected
  precedentId   Int?
  mubitRequestId String?
  model         String
  toolCalls     String   // JSON log of the agent's tool calls
  createdAt     DateTime @default(now())
}

model Precedent {
  id                Int      @id @default(autoincrement())
  brokerId          String
  broker            Broker   @relation(fields: [brokerId], references: [id])
  lineText          String
  oldCode           String
  newCode           String
  reason            String
  variantCount      Int      @default(0)
  variantsMatched   Int      @default(0)
  variantRequestIds String?  // JSON array of Mubit request ids from teaching variants
  createdAt         DateTime @default(now())
}

model Tariff {
  code        String  @id // 10 digits, declarable leaves only
  description String  // the leaf's own text, e.g. "Other"
  path        String  // heading > ... > leaf, so "Other" has meaning
  heading     String  // 4 digits
  chapter     String  // 2 digits
  dutyRate    String? // third-country duty, e.g. "6.00%"
}

model Chapter {
  id          String @id // 2 digits
  description String
  notes       String
}

model PastEntry {
  id           Int     @id @default(autoincrement())
  brokerId     String
  broker       Broker  @relation(fields: [brokerId], references: [id])
  entryDate    String
  text         String
  declaredCode String
  customsValue Float
  dutyPaid     Float
  findings     RetroFinding[]
}

model RetroFinding {
  id            Int       @id @default(autoincrement())
  pastEntryId   Int
  pastEntry     PastEntry @relation(fields: [pastEntryId], references: [id])
  suggestedCode String
  direction     String    // over | under | same | check | skip
  dutyDelta     Float
  reason        String
  maths         String?   // JSON DutyMaths: dates, rates, value, should-pay, assumption
  createdAt     DateTime  @default(now())
}

// Saved sign-ins and settings for each outside system (e.g. Shopify store + token, HMRC OAuth tokens).
// One per system for the whole app, so a broker signs in once.
model Credential {
  kind      String   @id // shopify | hmrc
  config    String   // JSON
  updatedAt DateTime @updatedAt
}

// An importer the broker works for. Its EORI is the importer (DE 3/16) on declarations;
// its Shopify store, if connected, is saved as the Credential "shopify:<id>".
model Client {
  id        Int      @id @default(autoincrement())
  brokerId  String
  broker    Broker   @relation(fields: [brokerId], references: [id])
  name      String
  eori      String?
  lines     Line[]
  createdAt DateTime @default(now())
}
